---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	wide?: boolean;
	loading?: 'eager' | 'lazy';
}

const { src, alt, caption, wide = false, loading = 'lazy' } = Astro.props;
---

<figure class:list={['figure', wide && 'figure-wide']}>
	<Image
		src={src}
		alt={alt}
		widths={[640, 960, 1440, 1920]}
		sizes={wide ? '(max-width: 1100px) 100vw, 1100px' : '(max-width: 700px) 100vw, 66ch'}
		formats={['avif', 'webp']}
		loading={loading}
		decoding={loading === 'eager' ? 'sync' : 'async'}
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
