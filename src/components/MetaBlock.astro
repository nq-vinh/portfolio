---
interface Props {
	role?: string;
	timeframe?: string;
	scope?: readonly string[];
	stack?: readonly string[];
}

const { role, timeframe, scope = [], stack = [] } = Astro.props;
const hasContent = Boolean(role || timeframe || scope.length > 0 || stack.length > 0);
---

{
	hasContent && (
		<dl class="meta-block">
			{role && (
				<div class="meta-block-row">
					<dt>Role</dt>
					<dd>{role}</dd>
				</div>
			)}
			{timeframe && (
				<div class="meta-block-row">
					<dt>Timeframe</dt>
					<dd>{timeframe}</dd>
				</div>
			)}
			{scope.length > 0 && (
				<div class="meta-block-row">
					<dt>What I owned</dt>
					<dd>
						<ul class="meta-block-list">
							{scope.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</dd>
				</div>
			)}
			{stack.length > 0 && (
				<div class="meta-block-row">
					<dt>Stack</dt>
					<dd>{stack.join(' · ')}</dd>
				</div>
			)}
		</dl>
	)
}
