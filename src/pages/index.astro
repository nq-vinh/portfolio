---
import { Picture } from 'astro:assets';
import HeroMeta from '../components/HeroMeta.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpeg';
import { profile } from '../data/profile';
import { getPublishedProjects } from '../lib/projects';

const projects = await getPublishedProjects();

if (projects.length === 0) throw new Error('The homepage requires at least one published project.');

// The grid is the page's main argument, so a card without a cover is a build error
// rather than a hole in the layout.
const uncovered = projects.filter(({ data }) => !data.cover).map(({ id }) => id);

if (uncovered.length > 0) {
	throw new Error(`Projects missing a cover image: ${uncovered.join(', ')}`);
}

const title = `${profile.name} - ${profile.role}`;
---

<Base title={title} description={profile.metaDescription}>
	<div class="content">
		<div class="hero">
			<div class="hero-copy">
				<h1>Hi, I'm <strong>{profile.shortName}</strong></h1>
				<p class="hero-role">{profile.role}</p>
				<p class="hero-introduction">{profile.tagline}</p>
			</div>
			<Picture
				pictureAttributes={{ class: 'portrait' }}
				src={portrait}
				formats={['avif', 'webp']}
				widths={[112, 224]}
				sizes="112px"
				width="112"
				height="112"
				alt={`Portrait of ${profile.name}`}
				loading="eager"
			/>
			<HeroMeta />
		</div>

		<section id="projects" class="content-section" aria-labelledby="projects-title">
			<SectionHeader headingId="projects-title" title="Selected work" />
			<div class="project-grid">
				{projects.map((project, index) => (
					<ProjectCard project={project} lead={index === 0} />
				))}
			</div>
		</section>

		<section id="now" class="content-section" aria-labelledby="now-title">
			<SectionHeader headingId="now-title" title="Now" />
			<ul class="now-list">
				{profile.now.map((item) => <li>{item}</li>)}
			</ul>
			<a href="/resume/">Full resume →</a>
		</section>

		<section id="contact" class="content-section contact" aria-labelledby="contact-title">
			<SectionHeader headingId="contact-title" title="Contact" />
			<p>The fastest way to reach me is email. I'm in Darmstadt, twenty minutes from Frankfurt, and open to senior frontend roles on-site, hybrid, or remote.</p>
			<ObfuscatedEmail class="contact-email" />
			<ul class="contact-links" aria-label="Social links">
				<SocialLinks />
			</ul>
		</section>
	</div>
</Base>
