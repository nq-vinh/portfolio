---
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';
import { getPublishedProjects } from '../../lib/projects';

const projects = await getPublishedProjects();

const title = `Projects · ${profile.name}`;
const description = `Case studies from ${profile.name}, a ${profile.role}.`;
---

<Base title={title} description={description}>
	<div class="content">
		<section class="content-section project-index" aria-labelledby="projects-title">
			<p class="eyebrow">Selected work</p>
			<h1 id="projects-title">Projects</h1>
			<div class="project-grid">
				{projects.map((project, index) => <ProjectCard project={project} lead={index === 0} headingLevel={2} />)}
			</div>
		</section>
	</div>
</Base>
